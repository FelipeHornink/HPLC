      <pou name="FB_Pump" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="AutoCmd">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="ManualCmd">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="ManualMode">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Permissive">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Feedback">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Reset">
              <type>
                <BOOL />
              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="Run">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Running">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="Fault">
              <type>
                <BOOL />
              </type>
            </variable>
          </outputVars>
          <localVars>
            <variable name="FeedbackTimer">
              <type>
                <derived name="TON" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">IF Reset THEN
    Fault := FALSE;
END_IF;
IF ManualMode THEN
    Run := ManualCmd AND Permissive AND NOT Fault;
ELSE
    Run := AutoCmd AND Permissive AND NOT Fault;
END_IF;
FeedbackTimer(IN := Run AND NOT Feedback, PT := T#2s);
IF FeedbackTimer.Q THEN
    Fault := TRUE;
END_IF;
Running := Run AND Feedback;</xhtml>
          </ST>
        </body>
      </pou>
