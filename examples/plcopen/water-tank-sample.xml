      <pou name="Main" pouType="program">
        <interface>
          <localVars>
            <variable name="Pump">
              <type>
                <derived name="FB_Pump" />
              </type>
            </variable>
            <variable name="Valve">
              <type>
                <derived name="FB_Valve" />
              </type>
            </variable>
            <variable name="StartEdge">
              <type>
                <derived name="R_TRIG" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">(* Routine 1 - field model used only on the bench. Disable SimEnable to drive
   the inputs by hand from the panel. *)
IF SimEnable THEN
    Inputs.PumpFeedback := Outputs.PumpRun;
    Inputs.ValveOpenFeedback := Outputs.ValveOpen;
    IF Outputs.PumpRun THEN
        SimLevel := SimLevel + SimInflowRate * SimScanSeconds;
    END_IF;
    IF Outputs.ValveOpen THEN
        SimLevel := SimLevel - SimOutflowRate * SimScanSeconds;
    END_IF;
    IF SimLevel &lt; 0.0 THEN
        SimLevel := 0.0;
    END_IF;
    IF SimLevel &gt; 100.0 THEN
        SimLevel := 100.0;
    END_IF;
    Analog.LevelRaw := REAL_TO_INT(SimLevel * 100.0);
END_IF;
(* Routine 2 - input scaling and operator mode. *)
Level := INT_TO_REAL(Analog.LevelRaw) / 100.0;
IF Level &lt; 0.0 THEN
    Level := 0.0;
END_IF;
IF Level &gt; 100.0 THEN
    Level := 100.0;
END_IF;
Status.AutoMode := Inputs.AutoSelector;
(* Routine 3 - level alarms with 1 % hysteresis. *)
IF Level &gt;= HighAlarmLimit THEN
    Status.HighAlarm := TRUE;
ELSIF Level &lt; HighAlarmLimit - 1.0 THEN
    Status.HighAlarm := FALSE;
END_IF;
IF Level &lt;= LowAlarmLimit THEN
    Status.LowAlarm := TRUE;
ELSIF Level &gt; LowAlarmLimit + 1.0 THEN
    Status.LowAlarm := FALSE;
END_IF;
(* Routine 4 - Auto cycle: Idle (0) -&gt; Filling (1) -&gt; Draining (2) -&gt; Filling ...
   Start (HMI or push button) starts the cycle; Stop, Manual mode or an
   equipment fault returns to Idle. *)
StartEdge(CLK := Hmi.StartCmd OR Inputs.StartButton);
IF Hmi.StopCmd OR NOT Inputs.StopButton OR NOT Status.AutoMode
   OR Status.PumpFault OR Status.ValveFault THEN
    Status.Running := FALSE;
ELSIF StartEdge.Q THEN
    Status.Running := TRUE;
END_IF;

CASE Status.State OF
    0: (* Idle *)
        IF Status.Running THEN
            IF Level &lt; FillTarget THEN
                Status.State := 1;
            ELSE
                Status.State := 2;
            END_IF;
        END_IF;
    1: (* Filling *)
        IF NOT Status.Running THEN
            Status.State := 0;
        ELSIF Level &gt;= FillTarget OR Status.HighAlarm THEN
            Status.State := 2;
        END_IF;
    2: (* Draining *)
        IF NOT Status.Running THEN
            Status.State := 0;
        ELSIF Level &lt;= DrainTarget OR Status.LowAlarm THEN
            Status.State := 1;
        END_IF;
ELSE
    Status.State := 0;
END_CASE;
(* Routine 5 - equipment objects and physical outputs. The alarms are
   interlocks in both modes: high level blocks the pump, low level blocks the valve. *)
Pump(AutoCmd := Status.State = 1,
     ManualCmd := Hmi.ManualPump,
     ManualMode := NOT Status.AutoMode,
     Permissive := NOT Status.HighAlarm,
     Feedback := Inputs.PumpFeedback,
     Reset := Hmi.ResetCmd);
Valve(AutoCmd := Status.State = 2,
      ManualCmd := Hmi.ManualValve,
      ManualMode := NOT Status.AutoMode,
      Permissive := NOT Status.LowAlarm,
      OpenFeedback := Inputs.ValveOpenFeedback,
      Reset := Hmi.ResetCmd);

Status.PumpRunning := Pump.Running;
Status.PumpFault := Pump.Fault;
Status.ValveIsOpen := Valve.IsOpen;
Status.ValveFault := Valve.Fault;

Outputs.PumpRun := Pump.Run;
Outputs.ValveOpen := Valve.Open;
Outputs.HighAlarmLamp := Status.HighAlarm;
Outputs.LowAlarmLamp := Status.LowAlarm;</xhtml>
          </ST>
        </body>
      </pou>
    </pous>
