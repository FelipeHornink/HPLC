    "viewsContainers": {
      "activitybar": [
        {
          "id": "hplc",
          "title": "HPLC",
          "icon": "media/plc.svg"
        }
      ]
    },
    "views": {
      "hplc": [
        {
          "id": "hplc.projects",
          "name": "%view.projects.name%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "hplc.addProject",
          "when": "view == hplc.projects",
          "group": "navigation@1"
        },
        {
          "command": "hplc.importXml",
          "when": "view == hplc.projects",
          "group": "navigation@2"
        },
        {
          "command": "hplc.newProject",
          "when": "view == hplc.projects",
          "group": "navigation@3"
        },
        {
          "command": "hplc.refresh",
          "when": "view == hplc.projects",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "hplc.exportXml",
          "when": "view == hplc.projects && (viewItem == plcProjectStopped || viewItem == plcProjectInactive || viewItem == plcProjectRunning)",
          "group": "inline@0"
        },
        {
          "command": "hplc.viewProject",
          "when": "view == hplc.projects && viewItem == plcProjectRunning",
          "group": "inline@1"
        },
        {
          "command": "hplc.togglePause",
          "when": "view == hplc.projects && viewItem == plcProjectRunning",
          "group": "inline@2"
        },
        {
          "command": "hplc.stop",
          "when": "view == hplc.projects && viewItem == plcProjectRunning",
          "group": "inline@3"
        },
        {
          "command": "hplc.playProject",
          "when": "view == hplc.projects && (viewItem == plcProjectStopped || viewItem == plcProjectInactive)",
          "group": "inline@1"
        },
        {
          "command": "hplc.configureProject",
          "when": "view == hplc.projects && (viewItem == plcProjectStopped || viewItem == plcProjectInactive || viewItem == plcProjectRunning)",
          "group": "2_project"
        },
        {
          "command": "hplc.removeProject",
          "when": "view == hplc.projects && (viewItem == plcProjectStopped || viewItem == plcProjectInactive)",
          "group": "2_project"
        },
        {
          "command": "hplc.openProjectPanel",
          "when": "view == hplc.projects && (viewItem == plcProjectStopped || viewItem == plcProjectRunning)",
          "group": "2_project"
        },
        {
          "command": "hplc.openProjectPid",
          "when": "view == hplc.projects && (viewItem == plcProjectStopped || viewItem == plcProjectRunning)",
          "group": "2_project"
        },
        {
          "command": "hplc.stop",
          "when": "view == hplc.processes && viewItem == plcRunningProcess",
          "group": "inline@1"
        },
        {
          "command": "hplc.openProjectPanel",
          "when": "view == hplc.processes && viewItem == plcRunningProcess",
          "group": "2_project"
        },
        {
          "command": "hplc.openProjectPid",
          "when": "view == hplc.processes && viewItem == plcRunningProcess",
          "group": "2_project"
        },
        {
          "command": "hplc.writeVariable",
          "when": "view == hplc.variables && (viewItem == plcVariableWritable || viewItem == plcVariableForced)",
          "group": "2_project"
        },
        {
          "command": "hplc.forceVariable",
          "when": "view == hplc.variables && viewItem == plcVariableWritable",
          "group": "2_project"
        },
        {
          "command": "hplc.unforceVariable",
          "when": "view == hplc.variables && viewItem == plcVariableForced",
          "group": "2_project"
        },
        {
          "command": "hplc.exportXml",
          "when": "view == hplc.projects && (viewItem == plcProjectStopped || viewItem == plcProjectInactive || viewItem == plcProjectRunning)",
          "group": "2_project"
        },
        {
          "command": "hplc.importXmlInto",
          "when": "view == hplc.projects && (viewItem == plcProjectStopped || viewItem == plcProjectInactive || viewItem == plcProjectRunning)",
          "group": "2_project"
        }
      ]
    },
    "languages": [
      {
        "id": "iec-st",
        "aliases": [
          "Structured Text",
          "ST"
        ],
        "extensions": [
          ".st"
        ]
      }
    ],
    "grammars": [
      {
        "language": "iec-st",
        "scopeName": "source.iec-st",
        "path": "./syntaxes/st.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "HPLC",
      "properties": {
        "hplc.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-BR"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.en%",
            "%config.language.ptBR%"
          ],
          "description": "%config.language.description%"
        },
        "hplc.simulationLayout": {
          "type": "string",
          "enum": [
            "below",
            "sideBySide"
          ],
          "default": "below",
          "enumDescriptions": [
            "%config.simulationLayout.below%",
            "%config.simulationLayout.sideBySide%"
          ],
          "description": "%config.simulationLayout.description%"
        },
        "hplc.layoutSimulacao": {
          "type": "string",
          "enum": [
            "embaixo",
            "lado a lado"
          ],
          "markdownDeprecationMessage": "%config.layoutSimulacao.deprecation%",
          "description": "%config.layoutSimulacao.description%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --check extension.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "2.26.1"
  },
